{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "state",
    "ready",
    "approved",
    "installed",
    "route",
    "overlay",
    "dependencies",
    "findings",
    "repair_candidates"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "state": {
      "enum": [
        "current",
        "repairable",
        "legacy",
        "source_changed",
        "unadopted",
        "deferred",
        "unmanaged",
        "invalid"
      ]
    },
    "ready": {
      "type": "boolean"
    },
    "approved": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "version",
            "source_sha256",
            "runtime_sha256",
            "bundle_root"
          ],
          "properties": {
            "version": {
              "type": "string"
            },
            "source_sha256": {
              "type": "string"
            },
            "runtime_sha256": {
              "type": "string"
            },
            "bundle_root": {
              "type": "string"
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "installed": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "version",
            "source_sha256",
            "runtime_sha256",
            "bundle_root"
          ],
          "properties": {
            "version": {
              "type": "string"
            },
            "source_sha256": {
              "type": "string"
            },
            "runtime_sha256": {
              "type": "string"
            },
            "bundle_root": {
              "type": "string"
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "route": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "valid",
        "detail"
      ],
      "properties": {
        "valid": {
          "type": "boolean"
        },
        "detail": {
          "type": "string"
        }
      }
    },
    "overlay": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "valid",
        "sha256",
        "expected_sha256",
        "detail"
      ],
      "properties": {
        "valid": {
          "type": "boolean"
        },
        "sha256": {
          "type": [
            "string",
            "null"
          ]
        },
        "expected_sha256": {
          "type": [
            "string",
            "null"
          ]
        },
        "detail": {
          "type": "string"
        }
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "stage",
          "status",
          "expected_sha256",
          "actual_sha256"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "stage": {
            "type": "string"
          },
          "status": {
            "enum": [
              "current",
              "missing",
              "changed",
              "invalid"
            ]
          },
          "expected_sha256": {
            "type": [
              "string",
              "null"
            ]
          },
          "actual_sha256": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "severity",
          "message",
          "path"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "severity": {
            "enum": [
              "info",
              "warning",
              "error"
            ]
          },
          "message": {
            "type": "string"
          },
          "path": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "repair_candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "action",
          "paths"
        ],
        "properties": {
          "action": {
            "const": "render_approved"
          },
          "paths": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "allOf": [
    {
      "if": {
        "properties": {
          "state": {
            "const": "current"
          }
        }
      },
      "then": {
        "properties": {
          "ready": {
            "const": true
          },
          "approved": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "version",
              "source_sha256",
              "runtime_sha256",
              "bundle_root"
            ],
            "properties": {
              "version": {
                "type": "string"
              },
              "source_sha256": {
                "type": "string"
              },
              "runtime_sha256": {
                "type": "string"
              },
              "bundle_root": {
                "type": "string"
              }
            }
          },
          "installed": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "version",
              "source_sha256",
              "runtime_sha256",
              "bundle_root"
            ],
            "properties": {
              "version": {
                "type": "string"
              },
              "source_sha256": {
                "type": "string"
              },
              "runtime_sha256": {
                "type": "string"
              },
              "bundle_root": {
                "type": "string"
              }
            }
          },
          "route": {
            "properties": {
              "valid": {
                "const": true
              }
            }
          },
          "overlay": {
            "properties": {
              "valid": {
                "const": true
              }
            }
          },
          "dependencies": {
            "minItems": 1,
            "items": {
              "properties": {
                "status": {
                  "const": "current"
                }
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "ready": {
            "const": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "const": "repairable"
          }
        }
      },
      "then": {
        "properties": {
          "repair_candidates": {
            "minItems": 1
          },
          "approved": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "version",
              "source_sha256",
              "runtime_sha256",
              "bundle_root"
            ],
            "properties": {
              "version": {
                "type": "string"
              },
              "source_sha256": {
                "type": "string"
              },
              "runtime_sha256": {
                "type": "string"
              },
              "bundle_root": {
                "type": "string"
              }
            }
          },
          "installed": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "version",
              "source_sha256",
              "runtime_sha256",
              "bundle_root"
            ],
            "properties": {
              "version": {
                "type": "string"
              },
              "source_sha256": {
                "type": "string"
              },
              "runtime_sha256": {
                "type": "string"
              },
              "bundle_root": {
                "type": "string"
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "repair_candidates": {
            "maxItems": 0
          }
        }
      }
    }
  ]
}
